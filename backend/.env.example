# Port des Servers (Frontend und API laufen beide hier)
PORT=3000
# Erlaubter CORS-Origin, muss zur URL im Browser passen
FRONTEND_URL=http://localhost:3000
# Beliebiger langer, geheimer String zum Signieren der JWTs
JWT_SECRET=hier_ein_langes_zufaelliges_secret_eintragen
# API Key von https://spoonacular.com/food-api/console
SPOONACULAR_API_KEY=hier_deinen_spoonacular_key_eintragen
# Optional: Username des Haupt-Admins, den andere Admins nicht aendern oder loeschen koennen
OWNER_USERNAME=
